# ============================================================
# AuraPet — Backend configuration (copy to .env; .env is gitignored)
# ============================================================

PORT=3001

# Mood labels + reset verification with Claude (recommended)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5     # default; claude-haiku-4-5 is faster if latency matters

# Speech-to-text (Anthropic has none). Set one to transcribe glasses audio on the server;
# without it, the phone's built-in speech recognition supplies the words.
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=qwen/qwen3.8-27b   (or openai/gpt-oss-120b)
# OPENAI_STT_MODEL=whisper-1
# OPENAI_LLM_MODEL=gpt-4o-mini

# Deploy (see README → Deploy for judging):
# APP_KEY is set ONLY on the hosted server (Render). Locally, `npm run package:prod <url>` generates
# PROD_APP_KEY here and bakes it into the .ehpk; set Render's APP_KEY to the same value.
# PROD_APP_KEY=
