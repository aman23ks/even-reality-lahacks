# ============================================================
# Even Reality G2 — Backend Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Backend server port
PORT=3001

# Add your API keys here:
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_API_KEY=...
# ANY_OTHER_API_KEY=...

# Backend URL (used by the frontend to reach your API)
# During local dev, this should be your laptop's LAN IP, NOT localhost,
# because the phone WebView needs to reach it over the network.
# Example: VITE_API_URL=http://192.168.1.42:3001
VITE_API_URL=http://localhost:3001
