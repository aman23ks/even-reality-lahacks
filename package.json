{
  "name": "even-reality-g2-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "npm run build && evenhub pack app.json dist -o g2-app.ehpk",
    "qr": "evenhub qr -u http://$(ipconfig getifaddr en0):5173",
    "mirror": "echo Open http://$(ipconfig getifaddr en0):5173/mirror.html on the projector",
    "start:demo": "bash scripts/start.sh",
    "stop": "bash scripts/stop.sh",
    "monitor": "node scripts/monitor.mjs $(ipconfig getifaddr en0)",
    "start": "tsx server/index.ts",
    "package:prod": "bash scripts/package-prod.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@evenrealities/even_hub_sdk": "latest",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
